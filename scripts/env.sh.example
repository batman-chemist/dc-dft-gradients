# Site-specific environment setup, sourced by the SLURM scripts.
#
#   cp env.sh.example env.sh     # env.sh is gitignored
#
# Then uncomment and edit whichever applies to your machine.

# --- conda / mamba ---
# source "${HOME}/miniforge3/etc/profile.d/conda.sh"
# conda activate <your-env>

# --- environment modules + venv ---
# module load python/3.11
# source "${HOME}/venvs/<your-env>/bin/activate"

# --- plain venv ---
# source "${HOME}/path/to/venv/bin/activate"
